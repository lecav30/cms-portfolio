# Neon/Postgres connection string. Require TLS for Neon; do not use a pooled
# connection string for schema migrations unless Neon documents it as supported.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/DATABASE?sslmode=require

# Generate a unique, high-entropy value (for example: `openssl rand -base64 48`).
# This is server-only and must differ across environments.
PAYLOAD_SECRET=replace-with-a-unique-long-random-secret

# Canonical URL for this standalone CMS. The value is public, but keep it exact.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Comma-separated browser origins allowed to make cross-origin Payload requests.
# Do not use `*`. Server-to-server reads from the portfolio do not require CORS.
CORS_ORIGINS=http://localhost:3000

# Bootstrap is one-time only: on startup, credentials are used only when no Users
# records exist. Remove these variables immediately after the first administrator
# has been created. Never commit the real values.
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-password
